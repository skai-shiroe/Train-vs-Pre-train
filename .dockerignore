# Tout ce qui n'est pas necessaire au build doit rester hors du contexte Docker.
# Un contexte reduit accelere le build et evite de faire fuiter des fichiers dans les layers.

.git/
.github/

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Donnees et artefacts : recuperes depuis le Model Registry, MLflow ou MinIO,
# ou montes en volume. Jamais copies dans un layer.
data/
artifacts/
mlruns/
mlartifacts/
mlflow.db
checkpoints/
*.pt
*.pth
*.safetensors
*.bin

# Resultats et documentation
reports/
docs/
site/
public/
notebooks/

# Secrets et configuration locale
.env
.env.local
.env.example
.secrets.baseline

# Fichiers de developpement inutiles au runtime.
# Les motifs Docker ne descendent pas dans l'arborescence : tests/ ne couvre que
# la racine, backend/tests/ doit donc etre nomme.
tests/
backend/tests/
.pre-commit-config.yaml
.markdownlint.yaml
.markdownlintignore
.yamllint.yaml
.vale.ini
.trivyignore
Makefile
mkdocs.yml
compose.yaml
deploy/
*.md
!README.md
