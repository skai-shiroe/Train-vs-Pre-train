# Copier en .env et remplir. Le .env reste hors du depot.
#
# Magasin MLflow. PostgreSQL porte les metadonnees des runs ; les artefacts,
# poids compris, vont dans MLFLOW_ARTIFACT_ROOT et jamais dans la base.
MLFLOW_TRACKING_URI=postgresql://utilisateur:motdepasse@hote:5432/syntra_mlflow

# Racine des artefacts. Chemin local ou URI. Compter environ 1,5 Go pour une
# campagne complete : les neuf modeles y sont deposes.
MLFLOW_ARTIFACT_ROOT=mlartifacts
