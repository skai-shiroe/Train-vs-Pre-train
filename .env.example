# Configuration d'exemple. Copier en .env et adapter.
# Ne jamais commiter le fichier .env : il est ignore par git.
#
# Les variables prefixees SYNTRA_ sont lues par backend/app/core/config.py.
# Leur parite avec la classe Settings est verifiee par scripts/check_sync.py.
# Les autres variables servent uniquement aux services de compose.yaml.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SYNTRA_APP_NAME=Syntra
SYNTRA_ENVIRONMENT=local
SYNTRA_DEBUG=false
SYNTRA_API_V1_PREFIX=/api/v1
SYNTRA_DOCS_ENABLED=true
# Origine publique publiee dans le bloc servers d'OpenAPI, et valeur de la
# variable baseUrl de l'environnement Postman. Schema, hote et port seulement :
# le chemin des routes vient de SYNTRA_API_V1_PREFIX.
SYNTRA_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Journalisation
# ---------------------------------------------------------------------------
SYNTRA_LOG_LEVEL=INFO
SYNTRA_LOG_JSON=true

# ---------------------------------------------------------------------------
# CORS. Liste separee par des virgules. L'etoile est refusee par validation.
# ---------------------------------------------------------------------------
SYNTRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SYNTRA_CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
SYNTRA_DEVICE=auto
SYNTRA_INFERENCE_TIMEOUT_S=30.0
SYNTRA_MAX_INPUT_CHARS=5000
SYNTRA_MAX_SUMMARY_TOKENS=64
SYNTRA_EAGER_LOAD_MODELS=true

# ---------------------------------------------------------------------------
# Model Registry
# ---------------------------------------------------------------------------
SYNTRA_REGISTRY_BACKEND=local
SYNTRA_REGISTRY_ROOT=artifacts/registry
SYNTRA_PRETRAINED_MODEL_ID=t5-small

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
SYNTRA_MLFLOW_TRACKING_URI=http://localhost:5000
SYNTRA_MLFLOW_EXPERIMENT=syntra-summarization

# ---------------------------------------------------------------------------
# Stockage objet MinIO. Laisser vide si inutilise.
# ---------------------------------------------------------------------------
SYNTRA_S3_ENDPOINT_URL=
SYNTRA_S3_ACCESS_KEY=
SYNTRA_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Services de compose.yaml. Non lus par l'application.
# Remplacer imperativement ces valeurs hors du poste de developpement.
# Le mot de passe PostgreSQL entre dans une URI : le garder sans caractere
# reserve, ou l'encoder.
# ---------------------------------------------------------------------------
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=mlflow
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_locally
MLFLOW_BUCKET=mlflow

# ---------------------------------------------------------------------------
# Images de la stack locale. Les tags par defaut de compose.yaml conviennent au
# poste de developpement. MINIO_IMAGE doit porter un tag RELEASE.* avant tout
# deploiement : MinIO ne publie pas de tag de version stable.
# ---------------------------------------------------------------------------
IMAGE_TAG=syntra-backend:dev
TRAINING_IMAGE_TAG=syntra-training:dev
MLFLOW_IMAGE_TAG=syntra-mlflow:dev
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# ---------------------------------------------------------------------------
# Ports publies par compose.yaml. A changer si le poste sert deja sur ces ports,
# par exemple un serveur MLflow lance hors conteneur sur 5000.
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
MLFLOW_PORT=5000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
